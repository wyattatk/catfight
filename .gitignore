# Anchored to the repo root on purpose. Unanchored, "build*" matches at any
# depth and silently swallows source files -- netplay/macos/build-server.sh
# was untrackable until this was fixed, with no error to say why. The build
# directories this is for (build/, build-catfight/, build-server/) are all at
# the root anyway.
/build*
*.swp
*tags
*~
/.vscode/
/baseq3

# catfight: map compiler output. The .map source is tracked; everything q3map2
# derives from it is not, since it is all rebuildable and the .bsp alone is
# larger than the source that produced it.
/catfight/maps/*.bsp
/catfight/maps/*.prt
/catfight/maps/*.srf
/catfight/maps/*.lin
/catfight/maps/*.aas

# catfight: cfmm build output and local state. Anchored for the same reason
# /build* above is -- an unanchored *.db would also swallow anything named that
# elsewhere in the tree. The database is per-deployment state, never source;
# the schema that creates it IS source and lives in internal/store/migrations.
/netplay/cfmm/cfmm
/netplay/cfmm/cfmm.exe
/netplay/cfmm/*.db
/netplay/cfmm/*.db-wal
/netplay/cfmm/*.db-shm
/netplay/cfmm/backups/
/netplay/cfagent/cfagent
/netplay/cfagent/cfagent.exe

